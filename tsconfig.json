{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "declaration": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "noImplicitAny": true,
        "outDir": "build",
        "paths": {
            "src": [
                "./src"
            ]
        },
        "rootDir": "src",
        "sourceMap": true,
        "strict": true,
        "target": "ES6"
    },
    "exclude": [
        "bin",
        "node_modules",
        "**/*.test.*",
        "**/*..*",
    ],
    "include": [
        "src",
        "tools",
    ]
}