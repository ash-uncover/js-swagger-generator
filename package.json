{
    "name": "@sol.ac/js-swagger-generator",
    "version": "0.0.1",
    "author": "aSH <ash.uncover@gmail.com>",
    "description": "Typescript code generator based on openAPI format",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/ash-uncover/js-swagger-generator"
    },
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "type": "module",
    "bin": {
        "js-swagger-generator": "./bin/js-swagger-generator.js"
    },
    "engines": {
        "node": ">=12.0.0"
    },
    "scripts": {
        "build": "tsc",
        "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\" \"src/**/*.js\" \"src/**/*.jsx\"",
        "lint": "",
        "prepare": "npm run build",
        "prepublishOnly": "npm run test",
        "test": "jest",
        "test-coverage": "jest --collectCoverage",
        "version": "npm run format"
    },
    "peerDependencies": {
        "@sol.ac/js-utils-fetch": "1.0.2"
    },
    "devDependencies": {
        "@types/jest": "30.0.0",
        "@types/node": "25.1.0",
        "jest": "30.2.0",
        "jest-junit": "16.0.0",
        "prettier": "3.8.1",
        "ts-jest": "29.4.6",
        "ts-loader": "9.5.4",
        "ts-node": "10.9.2",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "js-yaml": "^4.1.1"
    }
}
